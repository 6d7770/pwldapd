[Unit]
Description=LDAP daemon backed by local POSIX accounts
Documentation=man:pwldapd(8)
After=network.target

[Service]
Type=simple
ExecStart=/usr/sbin/pwldapd
Restart=on-failure
RestartSec=5

User=pwldapd
Group=pwldapd

# Creates /run/pwldapd owned by pwldapd:pwldapd, removed on stop.
RuntimeDirectory=pwldapd
RuntimeDirectoryMode=0755

# Fedora/RHEL have no "shadow" group and /etc/shadow is mode 0000, so
# pam_unix must exec the setuid unix_chkpwd helper to verify passwords.
# That helper needs to gain root (so NoNewPrivileges must stay off) and to
# read /etc/shadow (CAP_DAC_READ_SEARCH must be in the bounding set).
# CAP_NET_BIND_SERVICE allows binding to port 389 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_DAC_READ_SEARCH CAP_SETUID CAP_SETGID

# Tighten the attack surface.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
MemoryDenyWriteExecute=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
